# Assignment 7: Web crawler to pull product information and links from an e-commerce site
# pip install requests beautifulsoup4
# Uses books.toscrape.com - a practice e-commerce site made for scraping.
import csv
import requests
from bs4 import BeautifulSoup
from urllib.parse import urljoin

BASE = "http://books.toscrape.com/"
MAX_PAGES = 3  # number of listing pages to crawl

products = []
url = BASE

for page in range(MAX_PAGES):
    print("Crawling:", url)
    resp = requests.get(url, timeout=10)
    resp.encoding = "utf-8"
    soup = BeautifulSoup(resp.text, "html.parser")

    for item in soup.select("article.product_pod"):
        title = item.h3.a["title"]
        link = urljoin(url, item.h3.a["href"])
        price = item.select_one("p.price_color").text.strip()
        stock = item.select_one("p.availability").text.strip()
        rating = item.select_one("p.star-rating")["class"][1]
        products.append({
            "title": title,
            "price": price,
            "rating": rating,
            "availability": stock,
            "link": link,
        })

    nxt = soup.select_one("li.next a")
    if not nxt:
        break
    url = urljoin(url, nxt["href"])

# display
for p in products[:10]:
    print(f"{p['title'][:40]:40} | {p['price']:8} | {p['rating']:5} | {p['link']}")
print("\nTotal products:", len(products))

# save to CSV
with open("products.csv", "w", newline="", encoding="utf-8") as f:
    writer = csv.DictWriter(f, fieldnames=["title", "price", "rating", "availability", "link"])
    writer.writeheader()
    writer.writerows(products)
print("Saved to products.csv")

