# Assignment 2: Retrieval of documents using inverted files
import re
from collections import defaultdict

docs = {
    1: "Information retrieval deals with finding documents in large collections",
    2: "Search engines use inverted index for fast retrieval of documents",
    3: "Machine learning is used for text classification and clustering",
    4: "An inverted index maps each term to the documents containing it",
    5: "Web crawlers collect documents for search engines",
}

stop_words = {"is", "a", "an", "the", "of", "in", "for", "and", "to", "each", "it", "with"}

def tokenize(text):
    return [w for w in re.findall(r'[a-z]+', text.lower()) if w not in stop_words]

# ---- build inverted index: term -> {doc_id: term_frequency}
inverted = defaultdict(dict)
for doc_id, text in docs.items():
    for term in tokenize(text):
        inverted[term][doc_id] = inverted[term].get(doc_id, 0) + 1

print("INVERTED INDEX")
for term in sorted(inverted):
    print(f"{term:15} -> {sorted(inverted[term].items())}")

# ---- boolean AND retrieval
def search_and(query):
    terms = tokenize(query)
    if not terms:
        return set()
    result = set(inverted.get(terms[0], {}))
    for t in terms[1:]:
        result &= set(inverted.get(t, {}))
    return result

# ---- boolean OR retrieval, ranked by total term frequency
def search_ranked(query):
    scores = defaultdict(int)
    for t in tokenize(query):
        for doc_id, tf in inverted.get(t, {}).items():
            scores[doc_id] += tf
    return sorted(scores.items(), key=lambda x: -x[1])

while True:
    q = input("\nEnter query (or 'quit'): ").strip()
    if q.lower() == "quit":
        break
    print("AND match :", sorted(search_and(q)))
    print("Ranked    :", search_ranked(q))
    for doc_id, score in search_ranked(q):
        print(f"  Doc {doc_id} (score {score}): {docs[doc_id]}")

