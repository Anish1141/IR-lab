import matplotlib
matplotlib.use("Agg")  # saves the figure; remove this line to use plt.show()
import matplotlib.pyplot as plt
from sklearn.feature_extraction.text import TfidfVectorizer
from sklearn.cluster import AgglomerativeClustering
from scipy.cluster.hierarchy import linkage, dendrogram

docs = [
    "Cricket match was won by India in the final over",
    "The batsman scored a century in the test match",
    "Football world cup final is played tonight",
    "Neural networks are used for image classification",
    "Machine learning models need training data",
    "Deep learning improves speech recognition",
    "The stock market fell after the interest rate hike",
    "Banks raised interest rates to control inflation",
    "Share prices rose as the company reported profit",
]

# text -> TF-IDF vectors
vec = TfidfVectorizer(stop_words="english")
X = vec.fit_transform(docs).toarray()

# agglomerative clustering (bottom-up)
k = 3
model = AgglomerativeClustering(n_clusters=k, linkage="ward")
labels = model.fit_predict(X)

for c in range(k):
    print(f"\nCluster {c}:")
    for d, l in zip(docs, labels):
        if l == c:
            print("  -", d)

# dendrogram
Z = linkage(X, method="ward")
plt.figure(figsize=(10, 5))
dendrogram(Z, labels=[f"D{i+1}" for i in range(len(docs))])
plt.title("Agglomerative Hierarchical Clustering - Dendrogram")
plt.xlabel("Documents")
plt.ylabel("Distance")
plt.savefig("dendrogram.png")
print("\nDendrogram saved as dendrogram.png")

